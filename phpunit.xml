<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <!-- Pinned regardless of whatever a developer's own .env has set
             for live manual testing (e.g. PAYMENT_GATEWAY=stripe): the
             test suite must never depend on it, and must never be able to
             silently resolve the real Stripe gateway (CLAUDE.md section 9:
             tests must not hit real Stripe). Tests that specifically want
             the stripe binding already do config(['payments.gateway' =>
             'stripe']) themselves, with Stripe's HTTP transport faked. -->
        <env name="PAYMENT_GATEWAY" value="stub"/>
        <!-- A test-only dummy key, never a real credential: the same
             literal value already used everywhere a test constructs
             StripeClient directly (StripePaymentGatewayTest,
             StripeCheckoutFlowTest). Needed so the container-resolved
             StripeClient::class singleton (Checkout.php's own use of it)
             also gets a syntactically valid api_key: the Stripe SDK
             requires a non-empty key string to build a request at all,
             even though every test swaps out Stripe's HTTP transport
             (ApiRequestor::setHttpClient()) so nothing ever reaches the
             real network (CLAUDE.md section 9). Without this pin, tests
             silently depended on whatever STRIPE_SECRET happened to be
             in a developer's own .env, which CI's own "copy env example
             to env" step leaves empty, and Stripe's SDK rejects an empty
             (as opposed to unset) api_key outright. -->
        <env name="STRIPE_SECRET" value="sk_test_fake"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
